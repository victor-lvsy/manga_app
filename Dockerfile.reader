FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install playwright browsers (required for some scrapers)
RUN playwright install chromium
RUN playwright install-deps chromium

# Copy application code
COPY src/ ./src/
COPY alembic.ini .
COPY alembic/ ./alembic/

# Set environment variables
ENV PYTHONPATH=/app
ENV RUN_MODE=prod
ENV LOCAL_FOLDER=/app/local_comics

# Create local_comics directory
RUN mkdir -p /app/local_comics

# Expose port
EXPOSE 8888

# Run the reader application
CMD ["python", "-m", "uvicorn", "src.reader.app:app", "--host", "0.0.0.0", "--port", "8888", "--log-level", "error"]

